<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>0.36.0</Version>
    <Description>You can convert Excel to PDF.</Description>
    <PackageProjectUrl>https://github.com/Codeer-Software/Excel.Report.PDF</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Codeer-Software/Excel.Report.PDF</RepositoryUrl>
    <PackageTags>Excel;PDF;ExcelToPDF;Excel2PDF</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
	<PackageReleaseNotes>
		# Performance
		- Greatly improved OverWrite performance for #LoopRow / #LoopRowData with large data sets (rows are now inserted in bulk before copying instead of one block at a time; roughly 40x faster on a 1,000-row nested loop). Thanks to @meld-cp.

		# Adjustment
		- Row and column range detection (used by OverWrite, ReadAllTexts and ReadAllObjects) now includes cells that only have formatting or merged ranges, not just cells with values. As a result, ReadAllTexts / ReadAllObjects may return additional empty trailing rows or columns for sheets that contain formatted but empty cells.
	</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="PdfSharp" Version="6.2.3" />
	<PackageReference Include="QRCoder" Version="1.7.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
	
</Project>
